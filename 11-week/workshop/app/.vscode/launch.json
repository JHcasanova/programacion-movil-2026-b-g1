{
  "version": "0.2.0",
  "configurations": [
    {"name": "Ice Cream App · Demo", "request": "launch", "type": "dart", "cwd": "${workspaceFolder}/frontend", "program": "lib/main.dart"},
    {"name": "Ice Cream App · API local Android", "request": "launch", "type": "dart", "cwd": "${workspaceFolder}/frontend", "program": "lib/main.dart", "toolArgs": ["--dart-define=API_URL=http://10.0.2.2:3000"]},
    {"name": "Ice Cream App · Servidor propio", "request": "launch", "type": "dart", "cwd": "${workspaceFolder}/frontend", "program": "lib/main.dart", "toolArgs": ["--dart-define=API_URL=${input:apiUrl}"]}
  ],
  "inputs": [{"id": "apiUrl", "type": "promptString", "description": "URL del servidor sin barra final (HTTPS para producción)", "default": "https://tu-servidor.example"}]
}
